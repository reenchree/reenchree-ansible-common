# Managed by Ansible (reenchree.common.net_watchdog) — sourced by net-watchdog.sh
IFACE="{{ net_watchdog_interface }}"
NM_CONN="{{ net_watchdog_nm_connection }}"
WG_IF="{{ net_watchdog_wg_interface }}"
HEALTH_TARGETS="{{ net_watchdog_health_targets | join(' ') }}"
WAN_TARGETS="{{ net_watchdog_wan_targets | join(' ') }}"
HS_MAX_AGE="{{ net_watchdog_handshake_max_age_seconds }}"
GRACE="{{ net_watchdog_grace_seconds }}"
DWELL="{{ net_watchdog_rung_dwell_seconds }}"
RETRY_IVL="{{ net_watchdog_retry_interval_seconds }}"
DRY_RUN="{{ 'true' if net_watchdog_dry_run else 'false' }}"
STATE_DIR="{{ net_watchdog_state_dir }}"
TEXTFILE_DIR="{{ net_watchdog_textfile_directory }}"
